# ── App ──────────────────────────────────────────────────────────────────
NODE_ENV=development
# Port the app binds. Prod: 8092 (nginx proxies demos.ryanweiss.net → host:8092).
PORT=8092
HOST=0.0.0.0
LOG_LEVEL=debug
# Comma-separated allowed CORS origins for the /api. `*` = all. The manager UI
# is same-origin in prod so it needs nothing here; dev Vite runs on :5173.
CORS_ORIGINS=http://localhost:5173

# Public base URL, used only for display (e.g. "open public site" links).
PUBLIC_BASE_URL=http://localhost:8092

# ── Storage ──────────────────────────────────────────────────────────────
# Root folder where uploaded demos are unpacked: <DEMOS_ROOT>/<slug>/<n>/...
# Prod default is /opt/demos (created + chowned to ec2-user by setup-server.sh).
DEMOS_ROOT=./.demos-data
# Where the built manager SPA (client/dist) lives, served at /manage.
# Prod: /home/ec2-user/apps/demo-manager/client/dist
CLIENT_DIST_PATH=../client/dist
# Path the manager SPA is served under (must match the client's Vite `base`).
MANAGER_BASE_PATH=/manage

# ── Upload limits ──────────────────────────────────────────────────────────
MAX_UPLOAD_MB=200
MAX_ZIP_ENTRIES=5000
MAX_UNCOMPRESSED_MB=500

# ── Database (postgres) ─────────────────────────────────────────────────────
# Prod: ven-postgres is published on 127.0.0.1:5432; user `twenty`; db `demo_manager`.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=demo_manager
# Dev convenience only — auto-creates schema from entities. Keep false in prod.
DB_SYNCHRONIZE=false
# Run pending migrations on boot. true in prod so deploy = "ship + restart".
DB_RUN_MIGRATIONS=false

# ── PageLoop (in-page comments) ─────────────────────────────────────────────
# Endpoint of the PageLoop service whose widget is injected into published demos
# when a project has comments enabled. Prod: https://pageloop.ryanweiss.net
PAGELOOP_ENDPOINT=https://pageloop.ryanweiss.net

# ── Auth (future — not enforced yet) ────────────────────────────────────────
# Seam only; see docs/ARCHITECTURE.md §9. Leave disabled.
AUTH_ENABLED=false
