# /etc/systemd/system/demo-manager.service — ryanweiss.net box (162.35.181.92)
#
# Native Node service. Installed/refreshed by scripts/setup-server.sh.
#   Logs:    sudo journalctl -u demo-manager -f
#   Restart: sudo systemctl restart demo-manager
#
# Binds 127.0.0.1:4090; nginx (/etc/nginx/conf.d/demos.ryanweiss.net.conf)
# terminates TLS and proxies to it. Self-healing: Restart=always with no start
# limit, plus demo-manager-healthcheck.timer restarts it if /healthz stops answering.

[Unit]
Description=Demo Manager (demos.ryanweiss.net)
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=rw3iss
Group=rw3iss
WorkingDirectory=/var/www/demo-manager/server
EnvironmentFile=/etc/demo-manager/demo-manager.env
ExecStart=/usr/local/bin/node dist/main.js
Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=demo-manager

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/var/lib/demo-manager
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
